COMPOSE_PROJECT_NAME=teslapark

# --- MySQL -------------------------------------------------------------------
MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=teslapark
MYSQL_USER=teslapark
MYSQL_PASSWORD=teslapark_local_only
MYSQL_ROOT_PASSWORD=root_local_only
MYSQL_HOST_PORT=3306

# --- API ---------------------------------------------------------------------
API_HOST_PORT=3003
MICRONAUT_ENVIRONMENTS=dev
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Duser.timezone=UTC

DATASOURCE_URL=jdbc:mysql://mysql:3306/teslapark?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DATASOURCE_USERNAME=teslapark
DATASOURCE_PASSWORD=teslapark_local_only

# --- Gate Control System (emulador) ------------------------------------------
# A imagem declara EXPOSE 8080, mas o processo escuta em 3000.
# A imagem so existe para linux/amd64; em Apple Silicon roda sob emulacao.
GCS_IMAGE=cfontes0estapar/garage-sim:1.0.0
GCS_PLATFORM=linux/amd64
GCS_PORT=3000
GCS_HOST_PORT=3000

# A API compartilha o namespace de rede do GCS, entao os dois se enxergam em localhost.
# URL que a API usa para consultar GET /garage no GCS.
GCS_BASE_URL=http://localhost:3000

# URL que o GCS usa para publicar os eventos no webhook da API.
# A imagem 1.0.0 ignora esta variavel e resolve localhost:3003 internamente.
GCS_WEBHOOK_URL=http://localhost:3003/webhook

# --- Observabilidade ---------------------------------------------------------
PROMETHEUS_IMAGE=prom/prometheus:v3.1.0
PROMETHEUS_HOST_PORT=9090
GRAFANA_IMAGE=grafana/grafana:11.4.0
GRAFANA_HOST_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
